Description: NetBird
Author: Jordi Zayuelas i Muñoz
Version: 1.0
Id: 39fe76ce-f362-4de7-b8ea-72c6f6af0edf
RecreateDirectories: true
Targets:
    -
        Name: NetBird User Configuration
        Category: Communications
        Path: C:\Users\*\AppData\Roaming\netbird\
        FileMask: "*.json"
        Comment: "Collects Netbird User Configuration"

    -
        Name: NetBird System Logs
        Category: Communications
        Path: C:\ProgramData\Netbird\
        FileMask: "client.log"
        Comment: "Collects Netbird Logs"

    -
        Name: NetBird Configuration
        Category: Communications
        Path: C:\ProgramData\Netbird\
        FileMask: "*.json"
        Comment: "Collects Netbird Configuration"

# Documentation
# https://docs.netbird.io/help/troubleshooting-client
