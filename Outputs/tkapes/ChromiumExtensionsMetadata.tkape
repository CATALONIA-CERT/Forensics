Description: Collect Chromium-based browser extension manifest.json files (Chrome, Edge, Brave)
Author: CATALONIA-CERT
Version: 1.0
Id: f037f920-01f7-4ffe-87af-39a1b6fdbb16
RecreateDirectories: true

Targets:
    -
        Name: Chrome Browser Extension manifest.json (Extension ID, Version, Permissions)
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Google\Chrome\User Data\*\Extensions\
        Recursive: true
        FileMask: "manifest.json"
    -
        Name: Chrome Browser Extension messages.json (Friendly Name and Description)
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Google\Chrome\User Data\*\Extensions\*\*\_locales\en\
        Recursive: true
        FileMask: "messages.json"
    -
        Name: Chrome Beta Browser Extension manifest.json (Extension ID, Version, Permissions)
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Google\Chrome Beta\User Data\*\Extensions\
        Recursive: true
        FileMask: "manifest.json"
    -
        Name: Chrome Beta Browser Extension messages.json (Friendly Name and Description)
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Google\Chrome Beta\User Data\*\Extensions\*\*\_locales\en\
        Recursive: true
        FileMask: "messages.json"
    -
        Name: Chrome Dev Browser Extension manifest.json (Extension ID, Version, Permissions)
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Google\Chrome Dev\User Data\*\Extensions\
        Recursive: true
        FileMask: "manifest.json"
    -
        Name: Chrome Dev Browser Extension messages.json (Friendly Name and Description)
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Google\Chrome Dev\User Data\*\Extensions\*\*\_locales\en\
        Recursive: true
        FileMask: "messages.json"
    -
        Name: Chrome SxS - Canary Browser Extension manifest.json (Extension ID, Version, Permissions)
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Google\Chrome SxS\User Data\*\Extensions\
        Recursive: true
        FileMask: "manifest.json"
    -
        Name: Chrome SxS - Canary Browser Extension messages.json (Friendly Name and Description)
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Google\Chrome SxS\User Data\*\Extensions\*\*\_locales\en\
        Recursive: true
        FileMask: "messages.json"
    -
        Name: Edge Chromium Extension Files
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Microsoft\Edge\User Data\*\Extensions\
        Recursive: true
        FileMask: "manifest.json"
    -
        Name: Edge Beta Chromium Extension Files
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Microsoft\Edge Beta\User Data\*\Extensions\
        Recursive: true
        FileMask: "manifest.json"
    -
        Name: Edge Dev Chromium Extension messages.json
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Microsoft\Edge Dev\User Data\*\Extensions\
        Recursive: true
        FileMask: "messages.json"
    -
        Name: Edge Dev Chromium Extension Files
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Microsoft\Edge Dev\User Data\*\Extensions\
        Recursive: true
        FileMask: "messages.json"
    -
        Name: Edge SxS - Canary Chromium Extension Files
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\Microsoft\Edge SxS\User Data\*\Extensions\
        Recursive: true
        FileMask: "messages.json"
    -
        Name: Brave Extension Manifests
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Local\BraveSoftware\Brave-Browser\User Data\*\Extensions\
        Recursive: true
        FileMask: "manifest.json"
    -
        Name: Opera Extension Manifests
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Roaming\Opera Software\Opera Stable\Extensions\
        Recursive: true
        FileMask: "manifest.json"
    -
        Name: Opera GX Extension Manifests
        Category: Browser Extensions
        Path: C:\Users\%user%\AppData\Roaming\Opera Software\Opera GX Stable\Extensions\
        Recursive: true
        FileMask: "manifest.json"
